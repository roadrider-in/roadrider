{
  "expo": {
    "name": "RoadRider",
    "slug": "roadrider-user-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "roadrider",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171514"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roadrider.userapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RoadRider requires your location to display nearby food, rides, groceries, and delivery couriers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RoadRider requires your location to provide accurate delivery tracking and live ride estimates."
      }
    },
    "android": {
      "package": "com.roadrider.userapp",
      "adaptiveIcon": {
        "backgroundColor": "#171514",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CALL_PHONE",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
