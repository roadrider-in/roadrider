# ==============================================================================
# RoadRider Vendor Portal - Supabase Environment Configuration Template
# ==============================================================================
# HOW TO OBTAIN YOUR SUPABASE CREDENTIALS:
# 1. Sign in to your Supabase account: https://supabase.com/dashboard
# 2. Select your project (or create a new project)
# 3. Go to: Project Settings -> API
# 4. Under "Project URL", copy the URL -> paste into VITE_SUPABASE_URL
# 5. Under "Project API keys", copy the "anon" (public) or "publishable" key -> paste into VITE_SUPABASE_ANON_KEY
#
# IMPORTANT SECURITY GUIDELINES:
# - Use ONLY the public "anon" or "publishable" key in frontend client code.
# - NEVER include the "service_role" secret key here or in any frontend files.
#   The service_role key bypasses Row Level Security (RLS) policies.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
